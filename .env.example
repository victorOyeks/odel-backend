# Copy to .env on the server (never commit .env). Development needs none of these: run with SPRING_PROFILES_ACTIVE=dev.
SPRING_PROFILES_ACTIVE=api            # api | worker (same jar, run both)
ODEL_DB_URL=jdbc:postgresql://localhost:5432/odel
ODEL_DB_USER=odel
ODEL_DB_PASSWORD=
ODEL_REDIS_HOST=localhost
ODEL_REDIS_PORT=6379
ODEL_REDIS_PASSWORD=

ODEL_BASE_DOMAIN=                    # e.g. odel-staging.example.com -> wesley.<base>, console.<base>
ODEL_WEB_SCHEME=https
ODEL_SECURE_COOKIES=true
ODEL_MFA_KEY=                        # 32 random bytes, base64: openssl rand -base64 32

ODEL_GOOGLE_CLIENT_ID=
ODEL_GOOGLE_CLIENT_SECRET=
ODEL_GOOGLE_REDIRECT_URI=https://console.<base>/api/v1/auth/google/callback

# Cloudflare R2 (bucket odel-docs-dev / odel-docs-prod), token limited to Object Read & Write on its bucket
ODEL_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
ODEL_STORAGE_REGION=auto
ODEL_STORAGE_BUCKET=odel-docs-prod
ODEL_STORAGE_ACCESS_KEY=
ODEL_STORAGE_SECRET_KEY=

# Brevo SMTP relay
ODEL_SMTP_HOST=smtp-relay.brevo.com
ODEL_SMTP_PORT=587
ODEL_SMTP_USER=
ODEL_SMTP_PASSWORD=
ODEL_MAIL_FROM=no-reply@<verified sender domain>
ODEL_MAIL_FROM_NAME=ODeL Platform

# Firebase (browser push). Leave empty to log pushes only.
ODEL_FCM_PROJECT_ID=
ODEL_FCM_SERVICE_ACCOUNT_FILE=

ODEL_BOOTSTRAP_SUPER_ADMIN_EMAIL=     # first provider admin, created once on an empty platform
ODEL_BOOTSTRAP_SUPER_ADMIN_NAME=
