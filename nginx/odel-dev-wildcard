# Every university's platform address on dev: <slug>.odel-dev.oyeksglobal.com -> odel-web :3100.
# The web app proxies /api/* to the gateway, which finds the university from the host.
# Certificate: one wildcard, issued by DNS-01 through scripts/vps/certbot/cloudflare-*.sh (renews by itself).
# A more specific server_name (odel-dev, odel-console-dev, odel-api-dev) in odel-dev.oyeksglobal.com wins over this one.

server {
    server_name *.odel-dev.oyeksglobal.com;
    listen 443 ssl;
    listen [::]:443 ssl;
    ssl_certificate /etc/letsencrypt/live/odel-dev-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/odel-dev-wildcard/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 10m;
    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/json application/javascript text/javascript text/css text/plain image/svg+xml;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 5s;

    location ~ ^/api/v1/auth/(google|microsoft|email-code|mfa|dev) {
        limit_req zone=odel_dev_auth burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://odel_dev_web;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://odel_dev_web;
        proxy_read_timeout 30s;
    }
}

server {
    server_name *.odel-dev.oyeksglobal.com;
    listen 80;
    listen [::]:80;
    return 301 https://$host$request_uri;
}
